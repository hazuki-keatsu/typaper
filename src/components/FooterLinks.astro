---
import LinkButton from "./LinkButton.astro";

interface LinkGroup {
  title: string;
  links: { label: string; href: string; target: string }[];
}

const linkGroups: LinkGroup[] = [
  {
    title: "友情链接",
    links: [
      { label: "Blogroll", href: "/blogroll", target: "_self" },
    ],
  },
  {
    title: "外部服务",
    links: [
      { label: "CodeStats", href: "https://codestats.net/users/hazuki-keatsu", target: "_blank" },
    ],
  },
  {
    title: "本站",
    links: [
      { label: "RSS", href: "/rss.xml", target: "_blank" },
      { label: "RSS-daily", href: "/rss-daily.xml", target: "_blank" },
    ],
  },
];
---

<nav
  class="border-t border-border pt-6 pb-6"
  aria-label="Footer links"
>
  <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-3 sm:gap-x-8 max-w-xl">
    {
      linkGroups.map(group => (
        <section>
          <h4 class="text-sm font-semibold text-foreground/60">{group.title}</h4>
          <ul class="mt-3 space-y-2">
            {group.links.map(link => (
              <li>
                <LinkButton
                  href={link.href}
                  target={link.target}
                  class="text-sm text-foreground/80 hover:text-accent transition-colors"
                >
                  {link.label}
                </LinkButton>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</nav>
