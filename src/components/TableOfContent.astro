---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const h2s = headings.filter(h => h.depth === 2);
---

{
  h2s.length > 1 && (
    <div
      id="toc-wrapper"
      class="group fixed top-1/2 right-3 z-50 hidden -translate-y-1/2 pt-4 pb-4 pl-6 lg:block"
    >
      <div class="relative">
        {/* 卡片背景 —— hover 时淡入 */}
        <div
          id="toc-bg"
          class="pointer-events-none absolute inset-0 rounded-md border border-border/20 bg-background/80 opacity-0 shadow-lg shadow-black/5 backdrop-blur-xl transition-opacity duration-200 group-hover:opacity-100 dark:border-border/20 dark:bg-background/90 dark:shadow-black/20"
        />

        {/* 内容行：每行包含链接 + 指示器圆点 */}
        <ul class="relative flex flex-col px-2 py-3">
          {h2s.map((h, i) => (
            <li class="group/row flex h-7 items-center rounded-md hover:bg-muted/60 dark:hover:bg-muted">
              <a
                href={`#${h.slug}`}
                data-toc-link={i}
                class="toc-link block flex-1 truncate rounded-l px-2 py-0.5 text-sm text-foreground/60 opacity-0 transition-all duration-200 group-hover:opacity-100 group-hover/row:text-foreground group-hover/row:opacity-100 focus-visible:opacity-100 dark:text-foreground/60 dark:group-hover/row:text-foreground"
              >
                {h.text}
              </a>
              <span
                data-toc-dot={i}
                data-slug={h.slug}
                class="toc-dot flex h-7 w-6 cursor-pointer items-center justify-center border-0 bg-transparent p-0"
                aria-label={`跳转到 ${h.text}`}
              >
                <span class="block h-1 w-3 rounded-full bg-muted transition-all duration-300 dark:bg-muted" />
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}

<script>
  function initToc() {
    const wrapper = document.getElementById("toc-wrapper");
    if (!wrapper) return;

    const dots = wrapper.querySelectorAll<HTMLElement>("[data-toc-dot]");
    const links = wrapper.querySelectorAll<HTMLElement>("[data-toc-link]");
    if (dots.length === 0) return;

    let activeIdx = -1;

    function setActive(idx: number) {
      if (idx === activeIdx) return;
      // 清除旧激活
      if (activeIdx >= 0) {
        dots[activeIdx]?.removeAttribute("data-active");
        links[activeIdx]?.removeAttribute("data-active");
      }
      activeIdx = idx;
      if (idx >= 0) {
        dots[idx]?.setAttribute("data-active", "");
        links[idx]?.setAttribute("data-active", "");
      }
    }

    const headingEls = Array.from(dots)
      .map(dot => document.getElementById(dot.getAttribute("data-slug") || ""))
      .filter(Boolean) as HTMLElement[];

    if (headingEls.length === 0) return;

    const observerOptions: IntersectionObserverInit = {
      rootMargin: "0px 0px -70% 0px",
      threshold: 0,
    };

    const visibleHeadings = new Set<number>();

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        const idx = headingEls.indexOf(entry.target as HTMLElement);
        if (idx < 0) return;
        if (entry.isIntersecting) {
          visibleHeadings.add(idx);
        } else {
          visibleHeadings.delete(idx);
        }
      });

      if (visibleHeadings.size > 0) {
        setActive(Math.min(...visibleHeadings));
      } else {
        const firstHeading = headingEls[0];
        if (firstHeading) {
          const rect = firstHeading.getBoundingClientRect();
          if (rect.bottom < 0) {
            for (let i = headingEls.length - 1; i >= 0; i--) {
              if (
                headingEls[i].getBoundingClientRect().top <
                window.innerHeight * 0.3
              ) {
                setActive(i);
                break;
              }
            }
          }
        }
      }
    }, observerOptions);

    headingEls.forEach(el => observer.observe(el));

    // 链接 / 圆点点击 → 平滑滚动
    wrapper.addEventListener("click", e => {
      const link = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-toc-link]"
      );
      const dot = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-toc-dot]"
      );
      const idx = parseInt(
        link?.getAttribute("data-toc-link") ??
          dot?.getAttribute("data-toc-dot") ??
          ""
      );
      if (isNaN(idx)) return;
      const targetEl = headingEls[idx];
      if (targetEl) {
        e.preventDefault();
        targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
        setActive(idx);
        visibleHeadings.clear();
        visibleHeadings.add(idx);
      }
    });

    // 初始激活
    const initCheck = () => {
      for (let i = 0; i < headingEls.length; i++) {
        const rect = headingEls[i].getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.3 && rect.bottom > 0) {
          setActive(i);
          return;
        }
      }
      if (headingEls[0]?.getBoundingClientRect().top >= 0) {
        setActive(0);
      }
    };
    initCheck();
  }

  document.addEventListener("astro:page-load", initToc);
</script>

<style>
  #toc-bg {
    will-change: opacity;
  }

  /* 激活态圆点 */
  .toc-dot[data-active] span {
    width: 0.875rem;
    height: 0.375rem;
    background-color: var(--color-accent);
    box-shadow: 0 0 6px
      color-mix(in srgb, var(--color-foreground) 15%, transparent);
  }
  html[data-theme="dark"] .toc-dot[data-active] span {
    box-shadow: 0 0 8px
      color-mix(in srgb, var(--color-foreground) 25%, transparent);
  }

  /* 激活态链接 */
  .toc-link[data-active] {
    color: var(--color-foreground);
    font-weight: 500;
  }
</style>
