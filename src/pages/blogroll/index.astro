---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import IconUser from "@/assets/icons/IconUser.svg";
import LinkButton from "@/components/LinkButton.astro";

const entries = await getCollection("blogroll");
entries.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout title={`Blogroll | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Blogroll" pageDesc="Blogs and sites I enjoy reading.">
    <ul class="divide-y divide-border">
      {
        entries.map(entry => (
          <lin class="flex items-center gap-4 py-4 first:pt-0 last:pb-0">
            <div class="flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-muted">
              {entry.data.avatar ? (
                <Image
                  src={entry.data.avatar}
                  alt={`${entry.data.name} avatar`}
                  class="size-8 object-cover"
                />
              ) : (
                <IconUser class="m-2 size-5 text-foreground" />
              )}
            </div>
            <div class="min-w-0">
              <LinkButton
                href={entry.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-foreground underline underline-offset-2 transition-colors hover:text-accent"
              >
                {entry.data.name}
              </LinkButton>
              <p class="truncate text-sm text-foreground">
                {entry.data.description}
              </p>
            </div>
          </lin>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
